# Leave Supabase empty to run locally.
# `npm run db` starts PostgreSQL, creates the prodora account, and writes DATABASE_URL to .env.local.
# Without DATABASE_URL, orders stay in .data/demo-db.json.

NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=

# Supabase. All three are required together. The service role key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email. If RESEND_API_KEY is empty, messages are written to .data/outbox/.
RESEND_API_KEY=
EMAIL_FROM="Poruci <porudzbine@example.com>"

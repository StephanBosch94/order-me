# Leave Supabase empty to run in local demo mode.
# Demo orders are stored in .data/demo-db.json. That file is not a production database.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase. All three are required together. The service role key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email. If RESEND_API_KEY is empty, messages are written to .data/outbox/.
RESEND_API_KEY=
EMAIL_FROM="Poruci <porudzbine@example.com>"
